 {
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Neuron": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Neuron",
      "options": {
        "baseURL": "https://neuron.noser.com/v1"
      },
      "models": {
        "fast": {
          "name": "Fast"
        },
        "coding": {
          "name": "Coding"
        },
        "thinking": {
          "name": "Thinking",
          "attachment": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "lsp": "allow"
  }
}